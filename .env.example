# ── MergeGuard configuration ─────────────────────────────────────────────────
# Copy to .env and fill in. Loaded automatically on startup (python-dotenv).

# ── GitLab (required for live use) ───────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=                       # personal/group access token with `api` scope
GITLAB_WEBHOOK_SECRET=             # shared secret; must match the group webhook token

# ── Orbit ────────────────────────────────────────────────────────────────────
ORBIT_USE_LOCAL=false              # true → use `glab orbit query` (DuckDB) instead of Remote
ORBIT_CACHE=true                   # cache blast-radius lookups
ORBIT_CACHE_TTL=300                # seconds

# ── Storage ──────────────────────────────────────────────────────────────────
MERGEGUARD_DB=mergeguard.db        # SQLite path

# ── Public URL (used for comment action links: collision map, draft-fix) ─────
MERGEGUARD_PUBLIC_URL=             # e.g. https://mergeguard.your-host

# ── Phase 1.2 — Auto-fix MR generation (opt-in) ──────────────────────────────
MERGEGUARD_AUTOFIX_ENABLED=false   # true → open draft fix MRs (needs GITLAB_TOKEN)
MERGEGUARD_SOURCE_DIR=             # optional local repo mirror for offline auto-fix preview
                                   # (demo: demo/seed_data/sources)

# ── Phase 4.1 — Slack alerts (opt-in) ────────────────────────────────────────
SLACK_BOT_TOKEN=                   # xoxb-… bot token with chat:write
SLACK_CHANNEL=                     # channel id or #name
SLACK_MIN_SEVERITY=high            # low|medium|high|critical

# ── Phase 4.2 — CI/CD merge gate (opt-in) ────────────────────────────────────
MERGEGUARD_CI_GATE_ENABLED=false   # true → set a blocking commit status on MRs
MERGEGUARD_CI_GATE_MIN_SEVERITY=high

# ── Phase 2.1 — Cost model ───────────────────────────────────────────────────
MERGEGUARD_COST_MODEL=config/cost_model.json   # path to tunable cost assumptions
